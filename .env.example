# رابط الاتصال بقاعدة بيانات MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/almohandes?retryWrites=true&w=majority

# سر توقيع تسجيل الدخول - اجعله نصاً طويلاً وعشوائياً
JWT_SECRET=change-this-to-a-long-random-string

# بيانات دخول لوحة التحكم
ADMIN_USERNAME=admin
# استخدم "npm run hash-password -- كلمة_المرور" وضع الناتج هنا (موصى به)
ADMIN_PASSWORD_HASH=
# أو بدلاً من التشفير، كلمة مرور مباشرة (أقل أماناً - استخدمها فقط إذا لم تضع ADMIN_PASSWORD_HASH)
ADMIN_PASSWORD=

# اختياري: رفع الصور على Cloudinary بدلاً من تخزينها محلياً (موصى به على الاستضافة)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PORT=5000
